From: Teoman Madran <teoman@madran.me>
Subject: [PATCH] net: dsa: realtek: rtl8365mb: apply vendor EEE fixup on ver 0x00A0

The Realtek vendor driver sets bits 1-2 of PHY OCP register 0xA5D0 on
every internal PHY when the chip version is 0x00A0 (e.g. RTL8367S).
Do the same.

Signed-off-by: Teoman Madran <teoman@madran.me>
---
--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
@@ -128,6 +128,9 @@
 
 #define RTL8365MB_CHIP_VER_REG		0x1301
 
+/* PHY OCP register touched by the vendor EEE fixup */
+#define RTL8365MB_PHY_OCP_EEE_FIX	0xA5D0
+
 #define RTL8365MB_MAGIC_REG		0x13C2
 #define   RTL8365MB_MAGIC_VALUE		0x0249
 
@@ -2999,6 +3002,31 @@ static int rtl8365mb_switch_init(struct
 			return ret;
 	}
 
+	/* EEE fixup for the internal PHYs of ver 0x00A0 chips, lifted from
+	 * the vendor driver.
+	 */
+	if (ci->chip_ver == 0x00A0) {
+		struct dsa_port *dp;
+		u16 val;
+
+		dsa_switch_for_each_user_port(dp, &priv->ds) {
+			if (dp->index > RTL8365MB_PHYADDRMAX)
+				continue;
+
+			ret = rtl8365mb_phy_ocp_read(priv, dp->index,
+						     RTL8365MB_PHY_OCP_EEE_FIX,
+						     &val);
+			if (ret)
+				return ret;
+
+			ret = rtl8365mb_phy_ocp_write(priv, dp->index,
+						      RTL8365MB_PHY_OCP_EEE_FIX,
+						      val | 0x0006);
+			if (ret)
+				return ret;
+		}
+	}
+
 	return 0;
 }
 
