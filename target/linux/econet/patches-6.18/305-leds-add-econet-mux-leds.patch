From: TeomanM <teoman@madran.me>
Subject: [PATCH] leds: add EcoNet GPIO/hardware shared-pin LEDs

---
--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -390,6 +390,17 @@
 	  To use a pin as gpio pca9532_type in pca9532_platform data needs to
 	  set to PCA9532_TYPE_GPIO.
 
+config LEDS_ECONET_MUX
+	tristate "LED support for EcoNet GPIO/hardware shared pins"
+	depends on LEDS_CLASS && LEDS_TRIGGERS
+	depends on ECONET || COMPILE_TEST
+	depends on GPIOLIB
+	select MFD_SYSCON
+	help
+	  LEDs on EcoNet/TrendChip pins shared between a GPIO and a hardware
+	  function such as switch port LEDs. The hardware drives them until
+	  another trigger is selected.
+
 config LEDS_GPIO
 	tristate "LED Support for GPIO connected LEDs"
 	depends on LEDS_CLASS
--- a/drivers/leds/Makefile
+++ b/drivers/leds/Makefile
@@ -30,6 +30,7 @@
 obj-$(CONFIG_LEDS_CROS_EC)		+= leds-cros_ec.o
 obj-$(CONFIG_LEDS_DA903X)		+= leds-da903x.o
 obj-$(CONFIG_LEDS_DA9052)		+= leds-da9052.o
+obj-$(CONFIG_LEDS_ECONET_MUX)		+= leds-econet-mux.o
 obj-$(CONFIG_LEDS_GPIO)			+= leds-gpio.o
 obj-$(CONFIG_LEDS_GPIO_REGISTER)	+= leds-gpio-register.o
 obj-$(CONFIG_LEDS_HP6XX)		+= leds-hp6xx.o
