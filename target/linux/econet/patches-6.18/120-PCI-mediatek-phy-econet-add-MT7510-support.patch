--- a/drivers/pci/controller/pcie-mediatek.c
+++ b/drivers/pci/controller/pcie-mediatek.c
@@ -166,6 +166,7 @@
 	MTK_PCIE_NO_MSI = BIT(2),
 	MTK_PCIE_SKIP_RSTB = BIT(3),
 	MTK_PCIE_RETRAIN = BIT(4),
+	MTK_PCIE_NO_SYS_CK = BIT(5),
