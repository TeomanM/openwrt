From: TeomanM <teoman@madran.me>
Subject: PCI: mediatek: phy: econet: add MT7510 support

The MT7510 PCIe controller uses the MediaTek v1 register layout (shared
config window at 0x20/0x24, per-port PERST# in SYS_CFG, link status at
port + 0x50), with these differences:

- config address is bus[31:24] devfn[23:16] reg[11:2], and the window
  only takes 32-bit accesses (byte reads return the wrong lane);
- config offsets above 0x3ff hang the bus;
- both PERST# bits must be released for the RC1 link to train;
- port 1 interrupt enable is bit 26; resets and PERST# pinmux are in the
  SCU.

Its PHY is one block for both ports that needs the PLL programmed first.

The MT7592 (MT7603 die) found on these boards also needs a chip LDO
register set before its firmware will start.

Sequences follow the vendor 2.6.36 driver (pci-tc3162u.c, pcie-phy.c).

--- a/drivers/phy/phy-econet-pcie.c
+++ b/drivers/phy/phy-econet-pcie.c
@@ -83,6 +83,34 @@
 	{ /* sentinel */ }
 };
 
+/*
+ * MT7510: one PHY block serves both ports (bank 0x000 = port 0,
+ * 0x100 = port 1, 0x400 = shared PLL). Sequence from the vendor
+ * init_60901() for a 25 MHz crystal: take both ports down, set up the
+ * PLL and SSC, then enable both ports again.
+ */
+static const struct en75_phy_op mt7510_phy[] = {
+	{ 0x000, BIT(4), 1 },			/* port 0 force PHY enable */
+	{ 0x100, BIT(4), 1 },			/* port 1 force PHY enable */
+	{ 0x000, BIT(5), 0 },			/* port 0 PHY off */
+	{ 0x100, BIT(5), 0 },			/* port 1 PHY off */
+	{ 0x400, BIT(8), 1 },			/* force xtal type */
+	{ 0x400, GENMASK(10, 9), 0 },		/* xtal type: 25 MHz */
+	{ 0x490, GENMASK(15, 12), 0xa },	/* PLL_IR */
+	{ 0x4ac, GENMASK(18, 16), 1 },		/* PLL_BR */
+	{ 0x49c, GENMASK(30, 16), 0x1900 },	/* LCDDS_PCW_NCPO */
+	{ 0x49c, BIT(31), 0 },			/* latch PCW */
+	{ 0x49c, BIT(31), 1 },
+	{ 0x4a4, GENMASK(15, 0), 0x18d },	/* SSC period */
+	{ 0x4a8, GENMASK(11, 0), 0x4a },	/* SSC delta */
+	{ 0x4a8, GENMASK(27, 16), 0x4a },	/* SSC delta1 */
+	{ 0x400, BIT(12), 1 },			/* mstck_25m */
+	{ 0x400, BIT(11), 1 },			/* force mstck_25m */
+	{ 0x000, BIT(5), 1 },			/* port 0 PHY on */
+	{ 0x100, BIT(5), 1 },			/* port 1 PHY on */
+	{ /* sentinel */ }
+};
