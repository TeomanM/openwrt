/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "en751221.dtsi"

/ {
	model = "ASUS DSL-N16";
	compatible = "asus,dsl-n16", "econet,en751221";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x4000000>;
	};

	chosen {
		stdout-path = "/serial@1fbf0000:115200";
		linux,usable-memory-range = <0x00020000 0x03fe0000>;
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		key-reset {
			label = "reset";
			gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;	/* GPIO 32 */
			linux,code = <KEY_RESTART>;
		};

		key-wps {
			label = "wps";
			gpios = <&gpio1 17 GPIO_ACTIVE_LOW>;	/* GPIO 49 */
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		};

		led-dsl {
			label = "blue:dsl";
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
		};

		led-wan {
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
		};
	};
};

/*
 * MT7510 has no EN7523-style SPI controller; the SPI NOR (GD25Q128) sits on
 * the older TC3162 flash controller with a memory mapped read window.
 */
/delete-node/ &nand;

&spi_ctrl {
	status = "disabled";
};

/ {
	flash@1fbc0000 {
		compatible = "econet,mt7510-sfc";
		reg = <0x1fbc0000 0x100>, <0x1c000000 0x1000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x0 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_bootloader_fb00: eeprom@fb00 {
						/* MT7592 */
						reg = <0xfb00 0x400>;
					};

					macaddr_bootloader_ff48: macaddr@ff48 {
						compatible = "mac-base";
						reg = <0xff48 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@10000 {
				label = "romfile";
				reg = <0x10000 0x10000>;
				read-only;
			};

			/* Stock "tclinux" (0x20000-0xec0000) + "jffs2" (0xec0000-0xfc0000) */
			partition@20000 {
				label = "firmware";
				reg = <0x20000 0xfa0000>;
			};

			/* tclinux-trx pads header + kernel to 4 MiB */
			partition@420000 {
				label = "rootfs";
				reg = <0x420000 0xba0000>;
				linux,rootfs;
			};

			partition@fc0000 {
				label = "reservearea";
				reg = <0xfc0000 0x40000>;
				read-only;
			};
		};
	};
};

&gmac0 {
	status = "okay";
	nvmem-cells = <&macaddr_bootloader_ff48 0>;
	nvmem-cell-names = "mac-address";
};

/* MT7592 sits on the second root complex (stock log: RC1 link up). */
&pcie1 {
	status = "okay";
};

/* RC0 has no device (stock log: link down) */
&pcie_phy0 {
	status = "disabled";
};

&slot1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_bootloader_fb00>, <&macaddr_bootloader_ff48 1>;
		nvmem-cell-names = "eeprom", "mac-address";
	};
};

/*
 * MT7510 feeds GDMA1 (LAN) from the old PDMA engine, not QDMA, so it needs
 * its own driver (kmod-mt7510-eth). PDMA interrupt = MAC_INT (21). Only the
 * frame engine is reset; the switch keeps the bootloader's PHY setup.
 */
&ethernet {
	compatible = "econet,mt7510-eth";
	interrupts = <21>;
	resets = <&scuclk EN751221_FE_QDMA1_RST>;
	reset-names = "fe";
};

/* MT7510 CPU timer runs at 800 MHz / 3 (stock CPUTMR_CLK), not 200 MHz */
&hpt_clock {
	clock-frequency = <266666667>;
};
